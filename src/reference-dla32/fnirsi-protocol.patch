+static void deinterleave_dla32_samples(uint8_t *dest, const uint8_t *src, size_t num_frames,
+                                       int num_enabled_channels, size_t unitsize)
+{
+    /* Hardware frame size on wire is `unitsize * 8` bytes (1 byte per enabled channel for 8 time-steps).
+     * frame[i] contains 8 bits (s=0..7) for enabled channel i.
+     * Output: `unitsize` bytes per time-step in `dest` for sample-interleaved LA_SPLIT_DATA.
+     */
+    size_t hw_frame_size = unitsize * 8;
+    for (size_t f = 0; f < num_frames; f++) {
+        const uint8_t *frame = src + (f * hw_frame_size);
+        uint8_t *out_frame = dest + (f * 8 * unitsize);
+
+        for (int s = 0; s < 8; s++) {
+            uint8_t *sample_ptr = out_frame + (s * unitsize);
+            memset(sample_ptr, 0, unitsize);
+            for (int i = 0; i < num_enabled_channels; i++) {
+                if ((frame[i] >> s) & 1)
+                    sample_ptr[i / 8] |= (1U << (i % 8));
+            }
+        }
+    }
+}
