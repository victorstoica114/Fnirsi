+static int dev_acquisition_start(const struct sr_dev_inst *sdi)
+{
+    struct dev_context *devc = sdi ? sdi->priv : NULL;
+    uint8_t command[FNIRSI_DLA32_COMMAND_SIZE];
+    int enabled_count = 0;
+    uint32_t channel_mask = 0;
+
+    if (!sdi || !devc)
+        return SR_ERR_ARG;
+
+    for (GSList *l = sdi->channels; l; l = l->next) {
+        struct sr_channel *ch = l->data;
+        if (ch->type == SR_CHANNEL_LOGIC && ch->enabled) {
+            devc->channel_map[enabled_count++] = ch->index;
+            channel_mask |= (1U << ch->index);
+        }
+    }
+    if (enabled_count == 0) {
+        for (int i = 0; i < 32; i++)
+            devc->channel_map[i] = i;
+        enabled_count = 32;
+        channel_mask = 0xffffffff;
+    }
+    devc->num_enabled_channels = enabled_count;
+    devc->unitsize = (enabled_count + 7) / 8;
+
+    if (!make_setup_command(command, devc))
+        return SR_ERR_ARG;
+    if (send_command((struct sr_dev_inst *)sdi, command) != SR_OK)
+        return SR_ERR;
+
+    g_usleep(10000);
+
+    make_channel_command(command, channel_mask);
+    if (send_command((struct sr_dev_inst *)sdi, command) != SR_OK)
+        return SR_ERR;
+
+    devc->abort_acquisition = FALSE;
+    devc->samples_received = 0;
+    std_session_send_df_header(sdi);
+    std_session_send_df_trigger(sdi);
+    return sr_session_source_add(sdi->session, -1, 0, 10,
+        fnirsi_dla32_handle_events, (void *)sdi);
