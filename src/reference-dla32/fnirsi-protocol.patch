+static GSList *scan(struct sr_dev_driver *di, GSList *options)
+{
+    struct drv_context *drvc = di->context;
+    struct sr_dev_inst *sdi;
+    struct sr_usb_dev_inst *usb;
+    struct sr_channel_group *cg;
+    struct sr_channel *ch;
+    struct sr_config *src;
+    GSList *devices = NULL;
+    GSList *l;
+    const char *conn = NULL;
+    libusb_device **devlist;
+    struct libusb_device_descriptor des;
+    char connection_id[64];
+    int count;
+    int i;
+    int j;
+    int num_usb3 = 0;
+
+    for (l = options; l; l = l->next) {
+        src = l->data;
+        if (src->key == SR_CONF_CONN)
+            conn = g_variant_get_string(src->data, NULL);
+    }
+
+#ifdef _WIN32
+    load_ch375_dll();
+    if (fn_CH375OpenDevice) {
+        for (uint32_t dev_idx = 0; dev_idx < 4; dev_idx++) {
+            HANDLE h = fn_CH375OpenDevice(dev_idx);
+            if (h && h != INVALID_HANDLE_VALUE && h != (HANDLE)(LONG_PTR)-1) {
+                fn_CH375CloseDevice(dev_idx);
+                sdi = g_malloc0(sizeof(*sdi));
+                sdi->status = SR_ST_INACTIVE;
+                sdi->inst_type = SR_INST_USB;
+                sdi->vendor = g_strdup("FNIRSI");
+                sdi->model = g_strdup("DLA-32");
+                sdi->connection_id = g_strdup_printf("WCH-CH375/%u", dev_idx);
+                sdi->priv = g_malloc0(sizeof(struct dev_context));
+                ((struct dev_context *)sdi->priv)->samplerate = FNIRSI_DLA32_SAMPLERATE;
+                ((struct dev_context *)sdi->priv)->limit_samples = 0;
+                ((struct dev_context *)sdi->priv)->use_ch375 = TRUE;
+                ((struct dev_context *)sdi->priv)->ch375_index = dev_idx;
+                ((struct dev_context *)sdi->priv)->threshold_voltage = 1.6;
+                ((struct dev_context *)sdi->priv)->threshold_sel = 3;
+                ((struct dev_context *)sdi->priv)->op_mode = 0;
+
+                cg = sr_channel_group_new(sdi, "Logic", NULL);
+                for (j = 0; j < 32; j++) {
+                    ch = sr_channel_new(sdi, j, SR_CHANNEL_LOGIC, TRUE,
+                        channel_names[j]);
+                    cg->channels = g_slist_append(cg->channels, ch);
+                }
+                devices = g_slist_append(devices, sdi);
+            }
+        }
+        if (devices)
+            return std_scan_complete(di, devices);
+    }
+#endif
+
+    count = libusb_get_device_list(drvc->sr_ctx->libusb_ctx, &devlist);
+    if (count > 0) {
+        /* Check if USB 3.0 node (bcdUSB >= 0x0300) is present */
+        for (i = 0; i < count; i++) {
+            if (libusb_get_device_descriptor(devlist[i], &des) == 0 &&
+                is_dla32(&des) &&
+                des.bcdUSB >= 0x0300) {
+                num_usb3++;
+            }
+        }
+
+        for (i = 0; i < count; i++) {
+            if (libusb_get_device_descriptor(devlist[i], &des) != 0 ||
+                !is_dla32(&des))
+                continue;
+
+            /* Prefer USB 3.0 node (bcdUSB >= 0x0300) over USB 2.0 fallback (bcdUSB == 0x0200) */
+            if (num_usb3 > 0 && des.bcdUSB < 0x0300)
+                continue;
+
+            if (usb_get_port_path(devlist[i], connection_id,
+                sizeof(connection_id)) < 0)
+                continue;
+            if (conn && strcmp(conn, connection_id) != 0)
+                continue;
+
+            sdi = g_malloc0(sizeof(*sdi));
+            sdi->status = SR_ST_INACTIVE;
+            sdi->inst_type = SR_INST_USB;
+            sdi->vendor = g_strdup("FNIRSI");
+            sdi->model = g_strdup("DLA-32");
+            sdi->connection_id = g_strdup(connection_id);
+            usb = sr_usb_dev_inst_new(libusb_get_bus_number(devlist[i]),
+                libusb_get_device_address(devlist[i]), NULL);
+            sdi->conn = usb;
+            sdi->priv = g_malloc0(sizeof(struct dev_context));
+            ((struct dev_context *)sdi->priv)->samplerate = FNIRSI_DLA32_SAMPLERATE;
+            ((struct dev_context *)sdi->priv)->limit_samples = 0;
+            ((struct dev_context *)sdi->priv)->threshold_voltage = 1.6;
+            ((struct dev_context *)sdi->priv)->threshold_sel = 3;
+            ((struct dev_context *)sdi->priv)->op_mode = 0;
+
+            cg = sr_channel_group_new(sdi, "Logic", NULL);
+            for (j = 0; j < 32; j++) {
+                ch = sr_channel_new(sdi, j, SR_CHANNEL_LOGIC, TRUE,
+                    channel_names[j]);
+                cg->channels = g_slist_append(cg->channels, ch);
+            }
+            devices = g_slist_append(devices, sdi);
+        }
+
+        libusb_free_device_list(devlist, 1);
+    }
+
+    return std_scan_complete(di, devices);
+}
