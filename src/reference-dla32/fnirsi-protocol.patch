+            return SR_OK;
+        sr_err("DLA32 CH375WriteData failed.");
+        return SR_ERR;
+    }
+#endif
+
+    if (!usb || !usb->devhdl)
+        return SR_ERR;
+
+    ret = libusb_bulk_transfer(usb->devhdl, FNIRSI_DLA32_EP_OUT,
+        (unsigned char *)command, FNIRSI_DLA32_COMMAND_SIZE,
