+static int dev_open(struct sr_dev_inst *sdi)
+{
+    struct dev_context *devc = sdi ? sdi->priv : NULL;
+    struct drv_context *drvc = sdi->driver->context;
+    struct sr_usb_dev_inst *usb = sdi->conn;
+    libusb_device **devlist;
+    struct libusb_device_descriptor des;
+    int count;
+    int i;
+    int ret = SR_ERR;
+
+#ifdef _WIN32
+    if (devc && devc->use_ch375 && fn_CH375OpenDevice) {
+        HANDLE h = fn_CH375OpenDevice(devc->ch375_index);
+        if (h && h != INVALID_HANDLE_VALUE) {
+            if (fn_CH375SetTimeout)
+                fn_CH375SetTimeout(devc->ch375_index, 1000, 1000);
+            return SR_OK;
+        }
+        return SR_ERR;
+    }
+#endif
+
+    count = libusb_get_device_list(drvc->sr_ctx->libusb_ctx, &devlist);
+    if (count < 0)
+        return SR_ERR;
+    for (i = 0; i < count; i++) {
+        if (libusb_get_device_descriptor(devlist[i], &des) != 0 ||
+            !is_dla32(&des))
+            continue;
+        if (des.bcdUSB < 0x0300)
+            continue;
+        ret = libusb_open(devlist[i], &usb->devhdl);
+        if (ret == 0) {
+            usb->bus = libusb_get_bus_number(devlist[i]);
+            usb->address = libusb_get_device_address(devlist[i]);
+            break;
+        }
+    }
