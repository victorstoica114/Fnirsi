+
+    if (!sdi || !devc)
+        return SR_ERR_ARG;
+
+    if (!devc->abort_acquisition) {
+        devc->abort_acquisition = TRUE;
+        sr_session_source_remove(sdi->session, -1);
+
+        make_stop_command(command);
+        send_command(sdi, command);
+        std_session_send_df_end(sdi);
+    }
+    return SR_OK;
