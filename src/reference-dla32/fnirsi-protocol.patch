+static gboolean copy_verified_profile(uint8_t *command, const struct dev_context *devc)
+{
+    size_t i;
+
+    for (i = 0; i < ARRAY_SIZE(verified_profiles); i++) {
+        const struct setup_profile *profile = &verified_profiles[i];
+        if (profile->samplerate == devc->samplerate &&
+            profile->limit_samples == devc->limit_samples &&
+            profile->threshold_sel == devc->threshold_sel &&
+            profile->op_mode == devc->op_mode) {
+            memset(command, 0, FNIRSI_DLA32_COMMAND_SIZE);
+            memcpy(&command[8], profile->payload, sizeof(profile->payload));
+            return TRUE;
+        }
+    }
+
+    return FALSE;
+}
