+    if (!devc || devc->op_mode != 0 || devc->threshold_sel == 1 || devc->threshold_sel == 2) {
+        sr_err("DLA32 setup combination is not verified.");
+        return FALSE;
+    }
+    if (devc->threshold_sel < 0 || devc->threshold_sel >= (int)ARRAY_SIZE(threshold_volts) ||
