+            deinterleave_dla32_samples(logic_buf, buffer, num_frames,
+                devc->num_enabled_channels, devc->unitsize);
+            uint64_t samples_in_chunk = num_frames * 8;
+            if (devc->limit_samples && devc->samples_received + samples_in_chunk >= devc->limit_samples) {
+                samples_in_chunk = devc->limit_samples - devc->samples_received;
+                devc->abort_acquisition = TRUE;
+            }
