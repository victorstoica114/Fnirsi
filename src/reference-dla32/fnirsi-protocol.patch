+static void make_channel_command(uint8_t *command, uint32_t channel_mask)
+{
+    static const uint8_t channels_prefix[] = {
+        0x0a, 0x12, 0x27, 0x00, 0x00
+    };
+    static const uint8_t channels_suffix[] = {
+        0x0b, 0x69, 0x60, 0x33, 0x4e,
+    };
+
+    memset(command, 0, FNIRSI_DLA32_COMMAND_SIZE);
+    memcpy(&command[8], channels_prefix, sizeof(channels_prefix));
+    command[13] = (uint8_t)(channel_mask & 0xff);
+    command[14] = (uint8_t)((channel_mask >> 8) & 0xff);
+    command[15] = (uint8_t)((channel_mask >> 16) & 0xff);
+    command[16] = (uint8_t)((channel_mask >> 24) & 0xff);
+    memcpy(&command[8 + 41], channels_suffix, sizeof(channels_suffix));
+}
