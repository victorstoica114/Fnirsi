@@ -94,9 +94,13 @@ if [ "$USE_SYSTEM_QT" = true ]; then
 else
     if [ ! -d "$QT_PREFIX/$QT_VERSION/gcc_64" ]; then
         echo "   通过 aqtinstall 安装 Qt $QT_VERSION..."
